# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/library?retryWrites=true&w=majority)
# If not configured, the system uses the embedded persistent JSON database adapter seamlessly.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/library?retryWrites=true&w=majority"

# VITE_API_URL: Base URL for frontend REST calls (optional, defaults to /api)
VITE_API_URL="/api"
